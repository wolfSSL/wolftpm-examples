From 98f32fe6a1fffee472725111c51cf68f7460c988 Mon Sep 17 00:00:00 2001
From: David Garske <david@wolfssl.com>
Date: Wed, 7 Oct 2026 14:56:19 -0700
Subject: [PATCH] tls13: add private use code points for HashML-DSA signatures

---
 src/internal.c     |  83 +++++++++++++++++++++--
 src/tls13.c        | 161 ++++++++++++++++++++++++++++++++++++++++++---
 wolfssl/internal.h |  19 ++++++
 3 files changed, 249 insertions(+), 14 deletions(-)

diff --git a/src/internal.c b/src/internal.c
index 9afda1e2b3..10fcfd558d 100644
--- a/src/internal.c
+++ b/src/internal.c
@@ -3843,6 +3843,23 @@ static WC_INLINE void AddSuiteHashSigAlgo(byte* hashSigAlgo, byte macAlgo,
                 MLDSA_87_SA_MAJOR, MLDSA_87_SA_MINOR);
         }
         else
+      #ifdef WOLFSSL_HASH_MLDSA_TLS
+        if (sigAlgo == hash_mldsa_44_sa_algo) {
+            ADD_HASH_SIG_ALGO(hashSigAlgo, inOutIdx,
+                HASH_MLDSA_SA_MAJOR, HASH_MLDSA_44_SA_MINOR);
+        }
+        else
+        if (sigAlgo == hash_mldsa_65_sa_algo) {
+            ADD_HASH_SIG_ALGO(hashSigAlgo, inOutIdx,
+                HASH_MLDSA_SA_MAJOR, HASH_MLDSA_65_SA_MINOR);
+        }
+        else
+        if (sigAlgo == hash_mldsa_87_sa_algo) {
+            ADD_HASH_SIG_ALGO(hashSigAlgo, inOutIdx,
+                HASH_MLDSA_SA_MAJOR, HASH_MLDSA_87_SA_MINOR);
+        }
+        else
+      #endif /* WOLFSSL_HASH_MLDSA_TLS */
     #endif /* WOLFSSL_HAVE_MLDSA */
     #ifdef WOLFSSL_HAVE_SLHDSA
       #if defined(WOLFSSL_SLHDSA_SHA2) && defined(WOLFSSL_SLHDSA_PARAM_SHA2_128S)
@@ -4053,6 +4070,19 @@ void InitSuitesHashSigAlgo(byte* hashSigAlgo, int haveSig, int tls1_2,
 #endif /* HAVE_FALCON */
 #ifdef WOLFSSL_HAVE_MLDSA
     if (haveSig & SIG_MLDSA) {
+    #ifdef WOLFSSL_HASH_MLDSA_TLS
+        /* Offered ahead of the pure code points. A peer picks from this list
+         * in the order it is sent, and the only reason to enable this build
+         * option is a signer that implements the pre-hash form and not the
+         * pure one. A peer without the option never offers these, so it still
+         * negotiates the standard code points. */
+        AddSuiteHashSigAlgo(hashSigAlgo, no_mac, hash_mldsa_44_sa_algo,
+            keySz, &idx);
+        AddSuiteHashSigAlgo(hashSigAlgo, no_mac, hash_mldsa_65_sa_algo,
+            keySz, &idx);
+        AddSuiteHashSigAlgo(hashSigAlgo, no_mac, hash_mldsa_87_sa_algo,
+            keySz, &idx);
+    #endif /* WOLFSSL_HASH_MLDSA_TLS */
         AddSuiteHashSigAlgo(hashSigAlgo, no_mac, mldsa_44_sa_algo,
             keySz, &idx);
         AddSuiteHashSigAlgo(hashSigAlgo, no_mac, mldsa_65_sa_algo,
@@ -5562,18 +5592,47 @@ void DecodeSigAlg(const byte* input, byte* hashAlgo, byte* hsType)
     /* Hash performed as part of sign/verify operation.
      * However, if we want a dual alg signature with a classic algorithm as
      * alternative, we need an explicit hash algo here. */
-    #ifdef HAVE_FALCON
+    #if defined(HAVE_FALCON) || defined(WOLFSSL_HASH_MLDSA_TLS)
+        /* Falcon and the HashML-DSA private use code points share the major
+         * byte (0xFE); their minor bytes are disjoint (Falcon 0xD7/0xDA,
+         * HashML-DSA 0x01-0x03). */
         case FALCON_SA_MAJOR:
+        #ifdef HAVE_FALCON
             if (input[1] == FALCON_LEVEL1_SA_MINOR) {
                 *hsType = falcon_level1_sa_algo;
                 *hashAlgo = sha256_mac;
+                break;
             }
             else if (input[1] == FALCON_LEVEL5_SA_MINOR) {
                 *hsType = falcon_level5_sa_algo;
                 *hashAlgo = sha512_mac;
+                break;
             }
+        #endif /* HAVE_FALCON */
+        #ifdef WOLFSSL_HASH_MLDSA_TLS
+            /* The hash here is the pre-hash applied before signing, so it
+             * must match what the signer does. SHA-256 for every level: the
+             * only TPM known to implement the pre-hash form rejects any other
+             * digest size with TPM_RC_SIZE. Note this pairs a 128-bit
+             * collision strength with ML-DSA-65 and -87. */
+            if (input[1] == HASH_MLDSA_44_SA_MINOR) {
+                *hsType = hash_mldsa_44_sa_algo;
+                *hashAlgo = sha256_mac;
+                break;
+            }
+            else if (input[1] == HASH_MLDSA_65_SA_MINOR) {
+                *hsType = hash_mldsa_65_sa_algo;
+                *hashAlgo = sha256_mac;
+                break;
+            }
+            else if (input[1] == HASH_MLDSA_87_SA_MINOR) {
+                *hsType = hash_mldsa_87_sa_algo;
+                *hashAlgo = sha256_mac;
+                break;
+            }
+        #endif /* WOLFSSL_HASH_MLDSA_TLS */
             break;
-    #endif /* HAVE_FALCON */
+    #endif /* HAVE_FALCON || WOLFSSL_HASH_MLDSA_TLS */
     #if defined(WOLFSSL_HAVE_MLDSA) || defined(WOLFSSL_HAVE_SLHDSA)
         /* ML-DSA and SLH-DSA share the same major byte (0x09); their minor
          * bytes are disjoint (ML-DSA 0x04-0x06, SLH-DSA 0x11-0x1C). */
@@ -33450,17 +33509,31 @@ static int MatchSigAlgo(WOLFSSL* ssl, int hashAlgo, int sigAlgo)
         return sigAlgo == mldsa_87_sa_algo;
     }
     #endif /* WOLFSSL_MLDSA_FIPS204_DRAFT */
+    /* The pre-hash code points use the same key, so an ML-DSA certificate
+     * matches either form and the peer's preference order decides. */
     if (ssl->pkCurveOID == CTC_ML_DSA_44) {
         /* Certificate has ML-DSA level 2 key, only match with it. */
-        return sigAlgo == mldsa_44_sa_algo;
+        return (sigAlgo == mldsa_44_sa_algo)
+        #ifdef WOLFSSL_HASH_MLDSA_TLS
+            || (sigAlgo == hash_mldsa_44_sa_algo)
+        #endif
+            ;
     }
     if (ssl->pkCurveOID == CTC_ML_DSA_65) {
         /* Certificate has ML-DSA level 3 key, only match with it. */
-        return sigAlgo == mldsa_65_sa_algo;
+        return (sigAlgo == mldsa_65_sa_algo)
+        #ifdef WOLFSSL_HASH_MLDSA_TLS
+            || (sigAlgo == hash_mldsa_65_sa_algo)
+        #endif
+            ;
     }
     if (ssl->pkCurveOID == CTC_ML_DSA_87) {
         /* Certificate has ML-DSA level 5 key, only match with it. */
-        return sigAlgo == mldsa_87_sa_algo;
+        return (sigAlgo == mldsa_87_sa_algo)
+        #ifdef WOLFSSL_HASH_MLDSA_TLS
+            || (sigAlgo == hash_mldsa_87_sa_algo)
+        #endif
+            ;
     }
 #endif /* WOLFSSL_HAVE_MLDSA */
 #ifdef WC_RSA_PSS
diff --git a/src/tls13.c b/src/tls13.c
index d000adb23e..6fe393ff9b 100644
--- a/src/tls13.c
+++ b/src/tls13.c
@@ -9456,6 +9456,58 @@ static int SendTls13CertificateRequest(WOLFSSL* ssl, byte* reqCtx,
     (!defined(NO_RSA) || defined(HAVE_ECC) || defined(HAVE_ED25519) || \
      defined(HAVE_ED448) || defined(HAVE_FALCON) || defined(WOLFSSL_HAVE_MLDSA) || \
      defined(WOLFSSL_HAVE_SLHDSA))
+#ifdef WOLFSSL_HASH_MLDSA_TLS
+/* Pre-hash the data to be signed for a HashML-DSA code point.
+ *
+ * Digests in place, as CreateECCEncodedSig does, and reports the hash type to
+ * hand to the ML-DSA pre-hash API. Self-contained rather than reusing either
+ * of those helpers, which are behind HAVE_ECC and !WOLFSSL_NO_TLS12.
+ *
+ * sigData    The data to be signed; replaced by its digest.
+ * sigDataSz  The size of the data to be signed.
+ * hashAlgo   The TLS hash algorithm negotiated for the code point.
+ * hashType   Set to the matching wolfCrypt hash type.
+ * returns the digest length, or negative on error.
+ */
+static int CreateMlDsaPreHash(byte* sigData, int sigDataSz, int hashAlgo,
+    enum wc_HashType* hashType)
+{
+    int ret;
+    int hashSz;
+
+    switch (hashAlgo) {
+    #ifndef NO_SHA256
+        case sha256_mac:
+            *hashType = WC_HASH_TYPE_SHA256;
+            hashSz = WC_SHA256_DIGEST_SIZE;
+            break;
+    #endif
+    #ifdef WOLFSSL_SHA384
+        case sha384_mac:
+            *hashType = WC_HASH_TYPE_SHA384;
+            hashSz = WC_SHA384_DIGEST_SIZE;
+            break;
+    #endif
+    #ifdef WOLFSSL_SHA512
+        case sha512_mac:
+            *hashType = WC_HASH_TYPE_SHA512;
+            hashSz = WC_SHA512_DIGEST_SIZE;
+            break;
+    #endif
+        default:
+            return BAD_FUNC_ARG;
+    }
+
+    /* In place: the digest is never longer than the data it replaces. */
+    ret = wc_Hash(*hashType, sigData, (word32)sigDataSz, sigData,
+                  (word32)hashSz);
+    if (ret != 0)
+        return ret;
+
+    return hashSz;
+}
+#endif /* WOLFSSL_HASH_MLDSA_TLS */
+
 /* Encode the signature algorithm into buffer.
  *
  * hashalgo  The hash algorithm.
@@ -9552,6 +9604,20 @@ static WC_INLINE void EncodeSigAlg(const WOLFSSL * ssl, byte hashAlgo,
             output[0] = MLDSA_87_SA_MAJOR;
             output[1] = MLDSA_87_SA_MINOR;
             break;
+    #ifdef WOLFSSL_HASH_MLDSA_TLS
+        case hash_mldsa_44_sa_algo:
+            output[0] = HASH_MLDSA_SA_MAJOR;
+            output[1] = HASH_MLDSA_44_SA_MINOR;
+            break;
+        case hash_mldsa_65_sa_algo:
+            output[0] = HASH_MLDSA_SA_MAJOR;
+            output[1] = HASH_MLDSA_65_SA_MINOR;
+            break;
+        case hash_mldsa_87_sa_algo:
+            output[0] = HASH_MLDSA_SA_MAJOR;
+            output[1] = HASH_MLDSA_87_SA_MINOR;
+            break;
+    #endif /* WOLFSSL_HASH_MLDSA_TLS */
 #endif
 #ifdef WOLFSSL_HAVE_SLHDSA
     #if defined(WOLFSSL_SLHDSA_SHA2) && defined(WOLFSSL_SLHDSA_PARAM_SHA2_128S)
@@ -9816,21 +9882,46 @@ static WC_INLINE int DecodeTls13SigAlg(byte* input, byte* hashAlgo,
             else
                 ret = INVALID_PARAMETER;
             break;
-#if defined(HAVE_FALCON)
+#if defined(HAVE_FALCON) || defined(WOLFSSL_HASH_MLDSA_TLS)
+        /* Falcon and the HashML-DSA private use code points share the major
+         * byte (0xFE); their minor bytes are disjoint. */
         case FALCON_SA_MAJOR:
+            ret = INVALID_PARAMETER;
+    #if defined(HAVE_FALCON)
             if (input[1] == FALCON_LEVEL1_SA_MINOR) {
                 *hsType = falcon_level1_sa_algo;
                 /* Hash performed as part of sign/verify operation. */
                 *hashAlgo = sha512_mac;
+                ret = 0;
             } else if (input[1] == FALCON_LEVEL5_SA_MINOR) {
                 *hsType = falcon_level5_sa_algo;
                 /* Hash performed as part of sign/verify operation. */
                 *hashAlgo = sha512_mac;
+                ret = 0;
             }
-            else
-                ret = INVALID_PARAMETER;
+    #endif /* HAVE_FALCON */
+    #ifdef WOLFSSL_HASH_MLDSA_TLS
+            /* The hash here is the pre-hash applied before signing, so it
+             * must match what the signer does. SHA-256 for every level: the
+             * only TPM known to implement the pre-hash form rejects any other
+             * digest size with TPM_RC_SIZE. Note this pairs a 128-bit
+             * collision strength with ML-DSA-65 and -87. */
+            if (input[1] == HASH_MLDSA_44_SA_MINOR) {
+                *hsType = hash_mldsa_44_sa_algo;
+                *hashAlgo = sha256_mac;
+                ret = 0;
+            } else if (input[1] == HASH_MLDSA_65_SA_MINOR) {
+                *hsType = hash_mldsa_65_sa_algo;
+                *hashAlgo = sha256_mac;
+                ret = 0;
+            } else if (input[1] == HASH_MLDSA_87_SA_MINOR) {
+                *hsType = hash_mldsa_87_sa_algo;
+                *hashAlgo = sha256_mac;
+                ret = 0;
+            }
+    #endif /* WOLFSSL_HASH_MLDSA_TLS */
             break;
-#endif /* HAVE_FALCON */
+#endif /* HAVE_FALCON || WOLFSSL_HASH_MLDSA_TLS */
 #if defined(WOLFSSL_HAVE_MLDSA) || defined(WOLFSSL_HAVE_SLHDSA)
         /* ML-DSA and SLH-DSA share the same major byte (0x09); their minor
          * bytes are disjoint (ML-DSA 0x04-0x06, SLH-DSA 0x11-0x1C). */
@@ -11579,6 +11670,13 @@ static int SendTls13CertificateVerify(WOLFSSL* ssl)
         #if defined(WOLFSSL_HAVE_MLDSA)
             else if (ssl->hsType == DYNAMIC_TYPE_MLDSA) {
                 args->sigAlgo = ssl->buffers.keyType;
+            #ifdef WOLFSSL_HASH_MLDSA_TLS
+                /* A pre-hash code point uses the same key type, so the key
+                 * type does not say which was negotiated. */
+                if (SIG_ALGO_IS_HASH_MLDSA(ssl->options.sigAlgo)) {
+                    args->sigAlgo = ssl->options.sigAlgo;
+                }
+            #endif
             }
         #endif /* WOLFSSL_HAVE_MLDSA */
         #if defined(WOLFSSL_HAVE_SLHDSA)
@@ -11856,10 +11954,29 @@ static int SendTls13CertificateVerify(WOLFSSL* ssl)
         #endif /* HAVE_FALCON */
         #if defined(WOLFSSL_HAVE_MLDSA) && !defined(WOLFSSL_MLDSA_NO_SIGN)
             if (ssl->hsType == DYNAMIC_TYPE_MLDSA) {
-                ret = wc_MlDsaKey_SignCtx((wc_MlDsaKey*)ssl->hsKey, NULL, 0,
-                                          sigOut, &args->sigLen,
-                                          args->sigData, args->sigDataSz,
-                                          ssl->rng);
+            #ifdef WOLFSSL_HASH_MLDSA_TLS
+                if (SIG_ALGO_IS_HASH_MLDSA(args->sigAlgo)) {
+                    enum wc_HashType hashType = WC_HASH_TYPE_NONE;
+                    int hashSz = CreateMlDsaPreHash(args->sigData,
+                        args->sigDataSz, ssl->options.hashAlgo, &hashType);
+                    if (hashSz < 0) {
+                        ret = hashSz;
+                    }
+                    else {
+                        ret = wc_MlDsaKey_SignCtxHash(
+                            (wc_MlDsaKey*)ssl->hsKey, NULL, 0, sigOut,
+                            &args->sigLen, args->sigData, (word32)hashSz,
+                            (int)hashType, ssl->rng);
+                    }
+                }
+                else
+            #endif /* WOLFSSL_HASH_MLDSA_TLS */
+                {
+                    ret = wc_MlDsaKey_SignCtx((wc_MlDsaKey*)ssl->hsKey, NULL, 0,
+                                              sigOut, &args->sigLen,
+                                              args->sigData, args->sigDataSz,
+                                              ssl->rng);
+                }
                 args->length = args->sigLen;
             }
         #endif /* WOLFSSL_HAVE_MLDSA */
@@ -13025,6 +13142,15 @@ static int DoTls13CertificateVerify(WOLFSSL* ssl, byte* input,
                 validSigAlgo = (ssl->peerMlDsaKey != NULL) &&
                                ssl->peerMlDsaKeyPresent;
             }
+        #ifdef WOLFSSL_HASH_MLDSA_TLS
+            /* The pre-hash code points use an ordinary ML-DSA key, so the
+             * certificate check is the same one. */
+            if (SIG_ALGO_IS_HASH_MLDSA(ssl->options.peerSigAlgo)) {
+                WOLFSSL_MSG("Peer sent HashML-DSA sig");
+                validSigAlgo = (ssl->peerMlDsaKey != NULL) &&
+                               ssl->peerMlDsaKeyPresent;
+            }
+        #endif /* WOLFSSL_HASH_MLDSA_TLS */
         #endif
         #ifdef WOLFSSL_HAVE_SLHDSA
             if (IsSlhDsaSigAlgo(ssl->options.peerSigAlgo)) {
@@ -13317,10 +13443,27 @@ static int DoTls13CertificateVerify(WOLFSSL* ssl, byte* input,
         #if defined(WOLFSSL_HAVE_MLDSA) && !defined(WOLFSSL_MLDSA_NO_VERIFY)
             if (((ssl->options.peerSigAlgo == mldsa_44_sa_algo) ||
                  (ssl->options.peerSigAlgo == mldsa_65_sa_algo) ||
-                 (ssl->options.peerSigAlgo == mldsa_87_sa_algo)) &&
+                 (ssl->options.peerSigAlgo == mldsa_87_sa_algo) ||
+                 SIG_ALGO_IS_HASH_MLDSA(ssl->options.peerSigAlgo)) &&
                 (ssl->peerMlDsaKeyPresent)) {
                 int res = 0;
                 WOLFSSL_MSG("Doing ML-DSA peer cert verify");
+            #ifdef WOLFSSL_HASH_MLDSA_TLS
+                if (SIG_ALGO_IS_HASH_MLDSA(ssl->options.peerSigAlgo)) {
+                    enum wc_HashType hashType = WC_HASH_TYPE_NONE;
+                    int hashSz = CreateMlDsaPreHash(args->sigData,
+                        args->sigDataSz, ssl->options.peerHashAlgo, &hashType);
+                    if (hashSz < 0) {
+                        ret = hashSz;
+                    }
+                    else {
+                        ret = wc_MlDsaKey_VerifyCtxHash(ssl->peerMlDsaKey, sig,
+                            args->sigSz, NULL, 0, args->sigData,
+                            (word32)hashSz, (int)hashType, &res);
+                    }
+                }
+                else
+            #endif /* WOLFSSL_HASH_MLDSA_TLS */
                 ret = wc_MlDsaKey_VerifyCtx(ssl->peerMlDsaKey, sig, args->sigSz,
                                             NULL, 0, args->sigData,
                                             args->sigDataSz, &res);
diff --git a/wolfssl/internal.h b/wolfssl/internal.h
index 80cf9d810a..ad802b9a0a 100644
--- a/wolfssl/internal.h
+++ b/wolfssl/internal.h
@@ -1834,6 +1834,15 @@ enum Misc {
     MLDSA_87_SA_MAJOR = 0x09,
     MLDSA_87_SA_MINOR = 0x06,
 
+    /* HashML-DSA (FIPS 204 pre-hash) has no IETF code point. These are in the
+     * 0xFE00-0xFFFF private use range of RFC 8446, sharing the major byte with
+     * Falcon, and are not interoperable with anything else. Needed only for a
+     * signer that implements the pre-hash variant and not the pure one. */
+    HASH_MLDSA_SA_MAJOR    = 0xFE,
+    HASH_MLDSA_44_SA_MINOR = 0x01,
+    HASH_MLDSA_65_SA_MINOR = 0x02,
+    HASH_MLDSA_87_SA_MINOR = 0x03,
+
     /* These values for SLH-DSA correspond to the code points assigned in
      * draft-reddy-tls-slhdsa (0x0911-0x091C) and match what oqs-provider uses.
      * The major byte (0x09) is shared with ML-DSA. */
@@ -4911,9 +4920,19 @@ enum SignatureAlgorithm {
     slhdsa_shake_192f_sa_algo    = 29,
     slhdsa_shake_256s_sa_algo    = 30,
     slhdsa_shake_256f_sa_algo    = 31,
+    hash_mldsa_44_sa_algo        = 32,
+    hash_mldsa_65_sa_algo        = 33,
+    hash_mldsa_87_sa_algo        = 34,
     invalid_sa_algo              = 255
 };
 
+/* The pre-hash signature algorithms use the same keys and the same
+ * DYNAMIC_TYPE_MLDSA handshake key as the pure ones; only the signing
+ * operation differs. */
+#define SIG_ALGO_IS_HASH_MLDSA(a)                                           \
+    (((a) == hash_mldsa_44_sa_algo) || ((a) == hash_mldsa_65_sa_algo) ||    \
+     ((a) == hash_mldsa_87_sa_algo))
+
 #define PSS_RSAE_TO_PSS_PSS(macAlgo) \
     ((macAlgo) + (pss_sha256 - sha256_mac))
 
