# wolfBoot configuration for this demo.
#
# Same target as wolfBoot's own config/examples/psoc_c3.config, with the
# partitions resized. The demo image with every act including SPDM is about
# 190 KB, which does not fit the 0x17000 partitions the stock configuration
# uses.
#
# The layout is bounded by the debugger rather than by the part: J-Link
# programs only the low 256 KB of this device, so the bootloader and the boot
# partition together have to end at offset 0x40000. The update partition
# lives above that line; nothing writes it over SWD, and wolfBoot writes it at
# run time where no such limit applies.
#
#   0x12000000  wolfBoot          32 KB   (image is about 26 KB)
#   0x12008000  boot partition   224 KB   <- J-Link writes up to here
#   0x12040000  update partition 224 KB
#   0x12078000  swap
#
# 480 KB of the 512 KB part, leaving the top free.

ARCH?=ARM
TARGET?=psoc_c3
SIGN?=ECC256
HASH?=SHA256
DEBUG?=0
VTOR?=1
CORTEX_M33?=1
TZEN?=0
NO_ASM?=0
NO_MPU=1
EXT_FLASH?=0
SPI_FLASH?=0
ALLOW_DOWNGRADE?=0
NVM_FLASH_WRITEONCE?=0
FLAGS_INVERT?=1
WOLFBOOT_VERSION?=1
V?=0
SPMATH?=1
RAM_CODE?=1
DUALBANK_SWAP?=0

# Boot progress on the console. The demo's own output follows it on the same
# UART, so one capture shows the bootloader verifying the image and then the
# application running.
DEBUG_UART=1

WOLFBOOT_SECTOR_SIZE?=0x200
WOLFBOOT_PARTITION_SIZE?=0x38000
WOLFBOOT_PARTITION_BOOT_ADDRESS?=0x12008000
WOLFBOOT_PARTITION_UPDATE_ADDRESS?=0x12040000
WOLFBOOT_PARTITION_SWAP_ADDRESS?=0x12078000
